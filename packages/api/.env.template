STORE_CORS=http://localhost:3000,http://localhost:8000
ADMIN_CORS=http://localhost:7000,http://localhost:9000
VENDOR_CORS=http://localhost:7001
AUTH_CORS=http://localhost:7000,http://localhost:7001,http://localhost:9000
REDIS_URL=redis://localhost:6379
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
DATABASE_URL=
MERCUR_VENDOR_URL=http://localhost:7001
STOREFRONT_REVALIDATE_URL=http://localhost:3000/api/revalidate
# Must equal REVALIDATE_SECRET in apps/storefront/.env (lets the shop refresh cached prices)
STOREFRONT_REVALIDATE_SECRET=change-me
# Delivery — one platform rate, priced by road distance from vendor to customer
# (see src/lib/delivery/settings.ts). Restart the backend after changing.
DELIVERY_BASE_FEE=2
DELIVERY_PER_KM=0.5
DELIVERY_MIN_FEE=3
DELIVERY_ROUND_TO=0.5
# Whole-cart free delivery (0 = off) and where it applies ("" = anywhere)
# Default only — change it live in the admin panel → Delivery
FREE_DELIVERY_MIN_ORDER=300
FREE_DELIVERY_ORDER_CITIES=Harare
# Google Cloud key with Geocoding API, Routes API and Places API (New) enabled.
# Without it, distances are estimated from town centres and the address field
# has no suggestions.
GOOGLE_MAPS_API_KEY=

# Emails: order received, new order (to the vendor), cancelled, packed, shipped,
# delivered, customer-only promo codes. Sent through Resend (https://resend.com,
# free tier 3,000/month). Without a key each email is written to the backend log.
# Check your setup: TEST_EMAIL_TO=you@example.com bunx medusa exec ./src/scripts/send-test-email.ts
RESEND_API_KEY=
# Sender — its domain must be verified in Resend (until then use onboarding@resend.dev,
# which can only send to your own Resend account email).
EMAIL_FROM="Cepstrum3D <orders@yourdomain.co.zw>"
SITE_NAME=Cepstrum3D
# Shop link used in emails and in-store messages (include the country path)
STOREFRONT_URL=http://localhost:3000/zw
# Vendor portal link used in "New order" emails to vendors
VENDOR_PORTAL_URL=http://localhost:9000/seller
# Testing only: send emails to a fake Resend server instead of api.resend.com
# RESEND_API_URL=http://127.0.0.1:4010

# Manage inventory "Low stock" filter: available units below this count
LOW_STOCK_THRESHOLD=10

# Listings & reviews
# Every vendor product/listing waits for admin approval (admin → Listings). Keep true.
MEDUSA_FF_PRODUCT_REQUEST=true
# Who gets "new listing waiting for approval" emails (comma-separated)
ADMIN_NOTIFICATIONS_EMAIL=
# Reviews show straight away; set false to approve each one first (admin → Reviews)
REVIEWS_AUTO_PUBLISH=true
