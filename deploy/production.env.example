# Cepstrum3D — live server settings.
# Copy to /etc/cepstrum3d/production.env on the server and fill in every CHANGE-ME.
# deploy.sh reads this one file for the backend, both panels and the shop.

# ---------------------------------------------------------------- addresses
# The shop (what customers type). www.<SHOP_DOMAIN> redirects here automatically.
SHOP_DOMAIN=cepstrum3d.cepstrumtechnologies.com
# Backend + admin panel (/dashboard) + vendor portal (/seller)
API_DOMAIN=api.cepstrum3d.cepstrumtechnologies.com
# Email for Let's Encrypt certificate notices
ADMIN_EMAIL=CHANGE-ME@example.com

# ---------------------------------------------------------------- database & secrets
# Neon → your project → Connect → copy the connection string (keep ?sslmode=require).
# Pick the Neon region closest to the server (e.g. both in Frankfurt).
DATABASE_URL=postgresql://CHANGE-ME
REDIS_URL=redis://127.0.0.1:6379
# Make each with:  openssl rand -hex 32
JWT_SECRET=CHANGE-ME
COOKIE_SECRET=CHANGE-ME
# Shared between backend and shop so price changes show instantly. openssl rand -hex 24
REVALIDATE_SECRET=CHANGE-ME

# ---------------------------------------------------------------- shop
# Admin panel → Settings → Publishable API Keys → copy the key (starts with pk_)
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_CHANGE-ME
NEXT_PUBLIC_DEFAULT_REGION=zw

# ---------------------------------------------------------------- email (Resend)
RESEND_API_KEY=re_CHANGE-ME
# The domain here must be verified in Resend → Domains
EMAIL_FROM="Cepstrum3D <orders@cepstrumtechnologies.com>"
SITE_NAME=Cepstrum3D

# ---------------------------------------------------------------- Google Maps
# Places API (New), Geocoding API and Routes API enabled; restrict the key to this server's IP.
GOOGLE_MAPS_API_KEY=

# ---------------------------------------------------------------- delivery defaults
# (The free-delivery amount and towns are changed live in admin → Delivery.)
DELIVERY_BASE_FEE=2
DELIVERY_PER_KM=0.5
DELIVERY_MIN_FEE=3
DELIVERY_ROUND_TO=0.5
FREE_DELIVERY_MIN_ORDER=300
FREE_DELIVERY_ORDER_CITIES=Harare
LOW_STOCK_THRESHOLD=10

# ---------------------------------------------------------------- listings & reviews
# Who gets "new listing waiting for approval" emails (comma-separated)
ADMIN_NOTIFICATIONS_EMAIL=CHANGE-ME@cepstrumtechnologies.com
# Reviews show straight away; false = approve each one first in admin → Reviews
REVIEWS_AUTO_PUBLISH=true

# ---------------------------------------------------------------- don't change
MEDUSA_FF_PRODUCT_REQUEST=true
NODE_ENV=production
MEDUSA_DISABLE_TELEMETRY=true
NEXT_TELEMETRY_DISABLED=1
