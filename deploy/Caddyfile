# Written to /etc/caddy/Caddyfile by deploy.sh ({...} are filled in from production.env).
# Caddy gets and renews the HTTPS certificates by itself.
{
	email {ADMIN_EMAIL}
}

# The shop
{SHOP_DOMAIN} {
	encode zstd gzip
	reverse_proxy 127.0.0.1:3000
}

www.{SHOP_DOMAIN} {
	redir https://{SHOP_DOMAIN}{uri} permanent
}

# Backend API, admin panel (/dashboard), vendor portal (/seller), images (/static)
{API_DOMAIN} {
	encode zstd gzip
	request_body {
		max_size 25MB
	}
	reverse_proxy 127.0.0.1:9000
}
